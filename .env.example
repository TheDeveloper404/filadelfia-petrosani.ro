# Copy this file to .env and fill in values.
# Never commit .env to git.
#
# NOTE: Most site configuration lives in src/data/site-config.json
# (church name, schedule, ticker text, YouTube channel/playlist IDs, etc.)
#
# The variables below are read server-side by server/index.ts (Node, rulează pe VPS
# sub pm2), NU de build-ul Vite din browser. Nu au prefix VITE_ — nu ajung în bundle.

# Admin login (PIN + secretul de semnare al cookie-ului de sesiune)
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Detectare live YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Maileroo (formular de contact)
MAILEROO_API_KEY=
MAILEROO_FROM_ADDRESS=
MAILEROO_FROM_NAME=
MAILEROO_TO_ADDRESS=

# Bază de date locală (SQLite) — opțional, implicit ./data/app.db relativ la CWD
# DB_PATH=/var/www/filadelfia/data/app.db
